{
  "name": "meeting-protocol-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsc",
    "db:migrate": "tsx src/infrastructure/database/migrations/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seeds/seed.ts",
    "test:integration": "vitest run tests/integration/database"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.0",
    "pino": "9.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/express": "5.0.3",
    "@types/node": "22.15.32",
    "@types/pg": "8.15.4",
    "eslint": "9.30.1",
    "globals": "16.2.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.3",
    "supertest": "7.1.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  }
}
